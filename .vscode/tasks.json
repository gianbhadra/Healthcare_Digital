{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start healthcare backend",
      "type": "process",
      "command": "node",
      "args": ["index.js"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "healthcare-backend",
        "pattern": {
          "regexp": ".*",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Server berjalan di port 3000"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      }
    }
  ]
}
